    <string name="geo_privacy_title">Review geographic privacy</string>
    <string name="geo_privacy_body">A VPN exit changes your public IP address, but apps can still learn your physical location from Android location services, browser permission, Wi-Fi scanning and Bluetooth scanning. RatelMesh does not change these permissions without your consent.</string>
    <string name="geo_privacy_location_settings">Open location settings</string>
    <string name="geo_privacy_tracking_settings">Open privacy and advertising settings</string>
    <string name="geo_privacy_browser_steps">Browser: set website location permission to Block or Ask. Review Chrome/Brave WebRTC privacy if your threat model requires it.</string>
    <string name="geo_privacy_radio_steps">Location services: review Wi-Fi scanning and Bluetooth scanning. Disabling them may affect nearby-device and location features.</string>
