    <string name="geo_privacy_title">Review geographic privacy</string>
    <string name="geo_privacy_body">A VPN exit changes your public IP address, but apps can still learn your physical location from Android location services, browser permission, Wi-Fi scanning and Bluetooth scanning. RatelMesh does not change these permissions without your consent.</string>
