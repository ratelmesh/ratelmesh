[Unit]
Description=RatelMesh client daemon (ratelmeshd)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# RATELMESH_COORD and RATELMESH_AUTHKEY live here.
EnvironmentFile=/etc/ratelmesh/client.env
# Requires the wgreal build to bring up the tunnel. Add -kill-switch to fail
# closed while an exit is active; -accept-routes to accept subnet routes.
# The enrollment credential stays in the process environment instead of argv,
# so unprivileged users cannot read it from /proc/<pid>/cmdline.
ExecStart=/usr/local/bin/ratelmeshd -hostname %H -enable-nat \
  -state /var/lib/ratelmeshd -socket /run/ratelmeshd/ratelmeshd.sock
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
UMask=0077
StateDirectory=ratelmeshd
StateDirectoryMode=0700
RuntimeDirectory=ratelmeshd
RuntimeDirectoryMode=0700
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
