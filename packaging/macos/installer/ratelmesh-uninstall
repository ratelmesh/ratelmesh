#!/bin/sh
# Remove RatelMesh and, before deleting it, restore direct networking.
set -eu

ROOT=${RATELMESH_INSTALL_ROOT:-}
TEST_MODE=${RATELMESH_UNINSTALL_TEST_MODE:-0}
LABEL=com.ratelmesh.daemon
STATE="$ROOT/var/lib/ratelmesh"
ROUTE_COMMAND=${RATELMESH_UNINSTALL_ROUTE_COMMAND:-route}
PLIST_BUDDY=${RATELMESH_UNINSTALL_PLIST_BUDDY:-/usr/libexec/PlistBuddy}

cleanup_owned_routes() {
    ledger=$1
    [ -f "$ledger" ] || return 0
    converted=$(mktemp "${TMPDIR:-/tmp}/ratelmesh-route-ledger.XXXXXX")
    if ! plutil -convert xml1 -o "$converted" "$ledger"; then
        rm -f "$converted"
        echo "RatelMesh route ownership ledger is unreadable; refusing broad route cleanup." >&2
        return 1
    fi
    version=$("$PLIST_BUDDY" -c "Print :version" "$converted" 2>/dev/null || true)
    if [ "$version" != 1 ]; then
        rm -f "$converted"
        echo "RatelMesh route ownership ledger version is unsupported; refusing broad route cleanup." >&2
        return 1
    fi
    failed=0
    index=0
    while prefix=$("$PLIST_BUDDY" -c "Print :routes:$index:prefix" "$converted" 2>/dev/null); do
        gateway=$("$PLIST_BUDDY" -c "Print :routes:$index:gateway" "$converted" 2>/dev/null || true)
        device=$("$PLIST_BUDDY" -c "Print :routes:$index:device" "$converted" 2>/dev/null || true)
        kind=$("$PLIST_BUDDY" -c "Print :routes:$index:kind" "$converted" 2>/dev/null || true)
        case "$prefix" in
            ""|-*|*[!0-9A-Fa-f:./]*)
                echo "Invalid prefix in RatelMesh route ownership ledger." >&2
                failed=1
                break
                ;;
        esac
        case "$gateway" in
            -*|*[!A-Za-z0-9:._%-]*) failed=1; break ;;
        esac
        case "$device" in
            -*|*[!A-Za-z0-9._-]*) failed=1; break ;;
        esac
        case "$kind" in
            0|1|2|3) ;;
            *) failed=1; break ;;
        esac
        family=
        case "$prefix" in *:*) family=-inet6 ;; esac
        target=-net
        destination=$prefix
        if [ "$kind" = 3 ]; then
            target=-host
            destination=${prefix%/*}
        fi
        if [ "$kind" = 2 ]; then
            blackhole=127.0.0.1
            [ -z "$family" ] || blackhole=::1
            output=$("$ROUTE_COMMAND" -n delete ${family:+"$family"} "$target" "$destination" "$blackhole" -blackhole 2>&1) ||
                case "$output" in
                    *"not in table"*|*"not found"*) ;;
                    *) failed=1 ;;
                esac
        elif [ -n "$gateway" ]; then
            output=$("$ROUTE_COMMAND" -n delete ${family:+"$family"} "$target" "$destination" "$gateway" 2>&1) ||
                case "$output" in
                    *"not in table"*|*"not found"*) ;;
                    *) failed=1 ;;
                esac
        elif [ -n "$device" ]; then
            output=$("$ROUTE_COMMAND" -n delete ${family:+"$family"} "$target" "$destination" -interface "$device" 2>&1) ||
                case "$output" in
                    *"not in table"*|*"not found"*) ;;
                    *) failed=1 ;;
                esac
        else
            failed=1
        fi
        [ "$failed" -eq 0 ] || break
        index=$((index + 1))
    done
    rm -f "$converted"
    if [ "$failed" -ne 0 ]; then
        echo "Exact RatelMesh route cleanup failed; installation state was retained for retry." >&2
        return 1
    fi
    rm -f "$ledger"
}

if [ "${RATELMESH_UNINSTALL_ROUTE_TEST_MODE:-0}" = 1 ]; then
    cleanup_owned_routes "$STATE/route-owners-v1.json"
    exit $?
fi

if [ "$TEST_MODE" != 1 ] && [ "$(id -u)" -ne 0 ]; then
    echo "RatelMesh uninstall requires administrator privileges." >&2
    exit 1
fi

CONSOLE_USER=${RATELMESH_UNINSTALL_USER:-}
if [ -z "$CONSOLE_USER" ] && [ "$TEST_MODE" != 1 ]; then
    CONSOLE_USER=$(stat -f '%Su' /dev/console 2>/dev/null || true)
fi
USER_HOME=${RATELMESH_UNINSTALL_USER_HOME:-}
if [ -z "$USER_HOME" ] && [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != root ]; then
    USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
fi

if [ "$TEST_MODE" != 1 ]; then
    USER_ID=""
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != root ]; then
        USER_ID=$(id -u "$CONSOLE_USER" 2>/dev/null || true)
    fi
    [ -z "$USER_ID" ] || launchctl bootout "gui/$USER_ID/$LABEL.menubar" 2>/dev/null || true

    # SIGTERM gives ratelmeshd time to remove routes, restore DNS and close the utun.
    launchctl bootout "system/$LABEL" 2>/dev/null || true
    i=0
    while { pgrep -f '^/usr/local/ratelmesh/bin/ratelmeshd([[:space:]]|$)' >/dev/null 2>&1 || pgrep -f '^/usr/local/ratelmesh/bin/wireguard-go([[:space:]]|$)' >/dev/null 2>&1; } && [ "$i" -lt 20 ]; do
        sleep 0.25
        i=$((i + 1))
    done
    pkill -TERM -f '^/usr/local/ratelmesh/bin/ratelmeshd([[:space:]]|$)' 2>/dev/null || true
    pkill -TERM -f '^/usr/local/ratelmesh/bin/wireguard-go([[:space:]]|$)' 2>/dev/null || true
    sleep 1
    pkill -KILL -f '^/usr/local/ratelmesh/bin/ratelmeshd([[:space:]]|$)' 2>/dev/null || true
    pkill -KILL -f '^/usr/local/ratelmesh/bin/wireguard-go([[:space:]]|$)' 2>/dev/null || true

    # A SIGKILL cannot run normal route teardown. Reconcile the daemon's exact,
    # durable route owners; never delete a prefix without its recorded
    # gateway/interface because another VPN may own the same /1.
    cleanup_owned_routes "$STATE/route-owners-v1.json"

    # Reload PF only when a durable RatelMesh firewall marker or the exact
    # RatelMesh EXIT NAT rule proves that this installation replaced the global
    # ruleset. Merely having -enable-nat in the plist is permission, not proof
    # that NAT ever became active.
    PF_OWNED=0
    LEGACY_PF_MARKER=/var/run/h"bm"-killswitch.pf.conf
    for marker in \
        /var/run/ratelmesh-killswitch.pf.conf \
        /var/run/ratelmesh-pf-enabled \
        /var/run/ratelmesh-firewall-emergency \
        /var/run/ratelmesh-firewall-quarantine \
        "$LEGACY_PF_MARKER"; do
        [ ! -e "$marker" ] || PF_OWNED=1
    done
    PF_NAT_OWNED=0
    if pfctl -sn 2>/dev/null | grep -Eq 'nat on .* inet from 100\.64\.0\.0/10 to any'; then
        PF_NAT_OWNED=1
    fi
    if [ "$PF_OWNED" = 1 ] || [ "$PF_NAT_OWNED" = 1 ]; then
        pfctl -f /etc/pf.conf >/dev/null
    fi
    PF_ENABLE_PHASE=$(cat /var/run/ratelmesh-pf-enabled 2>/dev/null || true)
    if [ -e /var/run/ratelmesh-pf-enabled ] && [ "$PF_ENABLE_PHASE" != cancelled ]; then
        pfctl -d >/dev/null
    fi

    # A SIGKILL can prevent ratelmeshd from restoring DNS. Only reset a service whose
    # explicit DNS setting is RatelMesh's loopback resolver; preserve every other
    # custom DNS configuration.
    DEFAULT_DEV=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
    if [ -n "$DEFAULT_DEV" ]; then
        SERVICE=$(networksetup -listnetworkserviceorder 2>/dev/null | awk -v dev="$DEFAULT_DEV" '
            /^\([0-9]+\) / { service=$0; sub(/^\([0-9]+\) /, "", service) }
            index($0, "Device: " dev ")") { print service; exit }
        ')
        if [ -n "$SERVICE" ]; then
            DNS=$(networksetup -getdnsservers "$SERVICE" 2>/dev/null || true)
            if [ "$DNS" = "127.0.0.1" ]; then
                networksetup -setdnsservers "$SERVICE" Empty >/dev/null 2>&1 || true
            fi
        fi
    fi
    dscacheutil -flushcache >/dev/null 2>&1 || true
    killall -HUP mDNSResponder >/dev/null 2>&1 || true
fi

rm -f "$ROOT/Library/LaunchDaemons/$LABEL.plist"
rm -f "$ROOT/Library/LaunchAgents/$LABEL.menubar.plist"
rm -rf "$ROOT/usr/local/ratelmesh"
rm -rf "$ROOT/Applications/RatelMesh.app"
rm -rf "$STATE" "$ROOT/var/db/ratelmesh"
rm -f "$ROOT/var/run/ratelmesh.sock" "$ROOT/var/log/ratelmesh.log"
rm -f "$ROOT/var/run/ratelmesh-killswitch.pf.conf" \
    "$ROOT/var/run/ratelmesh-pf-enabled" \
    "$ROOT/var/run/ratelmesh-firewall-emergency" \
    "$ROOT/var/run/ratelmesh-firewall-quarantine" \
    "$ROOT/var/run/h""bm-killswitch.pf.conf" \
    "$ROOT/tmp/ratelmesh-utun-name"

if [ -n "$USER_HOME" ]; then
    rm -f "$ROOT$USER_HOME/Library/LaunchAgents/$LABEL.menubar.plist"
    rm -rf "$ROOT$USER_HOME/Applications/RatelMesh.app"
    rm -rf "$ROOT$USER_HOME/Library/Application Support/ratelmesh"
    rm -rf "$ROOT$USER_HOME/Library/HTTPStorages/$LABEL.menubar"
    rm -rf "$ROOT$USER_HOME/Library/Caches/$LABEL.menubar"
    rm -rf "$ROOT$USER_HOME/Library/Caches/RatelMesh"
    rm -f "$ROOT$USER_HOME/Library/Preferences/$LABEL.menubar.plist"
    rm -f "$ROOT$USER_HOME"/Library/Preferences/com.ratelmesh.daemon.update-*.plist
fi

if [ "$TEST_MODE" != 1 ]; then
    pkgutil --forget com.ratelmesh.daemon >/dev/null 2>&1 || true
    pkgutil --forget com.ratelmesh.daemon.universal >/dev/null 2>&1 || true
    pkgutil --forget com.ratelmesh.daemon.update >/dev/null 2>&1 || true
fi
